<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Dark palette: deep aubergine surfaces, gold for the caret and the active tab, lilac for selection and focus. -->
    <Color x:Key="WindowBackgroundColor">#16131C</Color>
    <Color x:Key="HairlineColor">#2A2632</Color>
    <Color x:Key="ChromeTextColor">#D9D3E3</Color>
    <Color x:Key="TitleBarTextColor">#A39BB2</Color>
    <Color x:Key="ChromeHoverColor">#262130</Color>
    <Color x:Key="ChromePressedColor">#2F2939</Color>
    <Color x:Key="EditorBackgroundColor">#1C1924</Color>
    <Color x:Key="EditorForegroundColor">#E6E1EE</Color>
    <Color x:Key="MutedTextColor">#A39BB2</Color>
    <Color x:Key="GutterTextColor">#5F586D</Color>
    <Color x:Key="GutterCurrentColor">#E8B53D</Color>
    <Color x:Key="CurrentLineColor">#0BFFFFFF</Color>
    <Color x:Key="SelectionColor">#5C8A5CC8</Color>
    <Color x:Key="CaretColor">#F0C55E</Color>
    <Color x:Key="AccentColor">#E8B53D</Color>
    <Color x:Key="AccentHoverColor">#F0C55E</Color>
    <Color x:Key="AccentPressedColor">#D9A52E</Color>
    <Color x:Key="OnAccentColor">#1E1606</Color>
    <Color x:Key="FocusColor">#B08AE6</Color>
    <Color x:Key="CheckFillColor">#A27BDB</Color>
    <Color x:Key="OnCheckColor">#16131C</Color>
    <Color x:Key="SurfaceColor">#25212E</Color>
    <Color x:Key="SurfaceHoverColor">#2D2837</Color>
    <Color x:Key="SurfacePressedColor">#353040</Color>
    <Color x:Key="SurfaceBorderColor">#3A3446</Color>
    <Color x:Key="InputBackgroundColor">#1F1B27</Color>
    <Color x:Key="PopupBackgroundColor">#221E2A</Color>
    <Color x:Key="PopupBorderColor">#393344</Color>
    <Color x:Key="MenuHighlightColor">#2F2A3A</Color>
    <Color x:Key="TabActiveColor">#1C1924</Color>
    <Color x:Key="TabHoverColor">#1E1A25</Color>
    <Color x:Key="TabTextColor">#9F97AE</Color>
    <Color x:Key="TabActiveTextColor">#ECE7F3</Color>
    <Color x:Key="TabIndicatorColor">#E8B53D</Color>
    <Color x:Key="StatusTextColor">#9C94AB</Color>
    <Color x:Key="CloseHoverColor">#C42B1C</Color>
    <Color x:Key="CloseHoverTextColor">#FFFFFF</Color>
    <Color x:Key="ListHoverColor">#26222F</Color>
    <Color x:Key="ListSelectedColor">#352E44</Color>
    <Color x:Key="ListSelectedTextColor">#F1ECF7</Color>
    <Color x:Key="ResultLocationColor">#C6A6F0</Color>
    <Color x:Key="ScrollThumbColor">#3A3446</Color>
    <Color x:Key="ScrollThumbHoverColor">#4D465B</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="HairlineBrush" Color="{StaticResource HairlineColor}" />
    <SolidColorBrush x:Key="ChromeTextBrush" Color="{StaticResource ChromeTextColor}" />
    <SolidColorBrush x:Key="TitleBarTextBrush" Color="{StaticResource TitleBarTextColor}" />
    <SolidColorBrush x:Key="ChromeHoverBrush" Color="{StaticResource ChromeHoverColor}" />
    <SolidColorBrush x:Key="ChromePressedBrush" Color="{StaticResource ChromePressedColor}" />
    <SolidColorBrush x:Key="EditorBackgroundBrush" Color="{StaticResource EditorBackgroundColor}" />
    <SolidColorBrush x:Key="EditorForegroundBrush" Color="{StaticResource EditorForegroundColor}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />
    <SolidColorBrush x:Key="GutterTextBrush" Color="{StaticResource GutterTextColor}" />
    <SolidColorBrush x:Key="GutterCurrentBrush" Color="{StaticResource GutterCurrentColor}" />
    <SolidColorBrush x:Key="CurrentLineBrush" Color="{StaticResource CurrentLineColor}" />
    <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource SelectionColor}" />
    <SolidColorBrush x:Key="CaretBrush" Color="{StaticResource CaretColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{StaticResource FocusColor}" />
    <SolidColorBrush x:Key="CheckFillBrush" Color="{StaticResource CheckFillColor}" />
    <SolidColorBrush x:Key="OnCheckBrush" Color="{StaticResource OnCheckColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="{StaticResource SurfacePressedColor}" />
    <SolidColorBrush x:Key="SurfaceBorderBrush" Color="{StaticResource SurfaceBorderColor}" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource InputBackgroundColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{StaticResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{StaticResource PopupBorderColor}" />
    <SolidColorBrush x:Key="MenuHighlightBrush" Color="{StaticResource MenuHighlightColor}" />
    <SolidColorBrush x:Key="TabActiveBrush" Color="{StaticResource TabActiveColor}" />
    <SolidColorBrush x:Key="TabHoverBrush" Color="{StaticResource TabHoverColor}" />
    <SolidColorBrush x:Key="TabTextBrush" Color="{StaticResource TabTextColor}" />
    <SolidColorBrush x:Key="TabActiveTextBrush" Color="{StaticResource TabActiveTextColor}" />
    <SolidColorBrush x:Key="TabIndicatorBrush" Color="{StaticResource TabIndicatorColor}" />
    <SolidColorBrush x:Key="StatusTextBrush" Color="{StaticResource StatusTextColor}" />
    <SolidColorBrush x:Key="CloseHoverBrush" Color="{StaticResource CloseHoverColor}" />
    <SolidColorBrush x:Key="CloseHoverTextBrush" Color="{StaticResource CloseHoverTextColor}" />
    <SolidColorBrush x:Key="ListHoverBrush" Color="{StaticResource ListHoverColor}" />
    <SolidColorBrush x:Key="ListSelectedBrush" Color="{StaticResource ListSelectedColor}" />
    <SolidColorBrush x:Key="ListSelectedTextBrush" Color="{StaticResource ListSelectedTextColor}" />
    <SolidColorBrush x:Key="ResultLocationBrush" Color="{StaticResource ResultLocationColor}" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="{StaticResource ScrollThumbColor}" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="{StaticResource ScrollThumbHoverColor}" />

    <!-- The corner between two scroll bars. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="{StaticResource EditorBackgroundColor}" />

    <sys:Double x:Key="PopupShadowOpacity">0.45</sys:Double>
</ResourceDictionary>
