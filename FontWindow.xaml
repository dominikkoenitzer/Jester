<local:ThemedWindow x:Class="Jester.FontWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Jester"
        Style="{StaticResource JesterWindowStyle}"
        Title="Font" Width="520" Height="440"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="90" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Font:" Margin="0,0,0,4" />
        <TextBlock Grid.Row="0" Grid.Column="1" Text="Size:" Margin="10,0,0,4" />

        <ListBox x:Name="FamilyList" Grid.Row="1" Grid.Column="0"
                 DisplayMemberPath="Source"
                 SelectionChanged="Selection_Changed" />

        <Grid Grid.Row="1" Grid.Column="1" Margin="10,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBox x:Name="SizeBox" Grid.Row="0" Padding="2,3" Margin="0,0,0,4"
                     TextChanged="SizeBox_TextChanged" />
            <ListBox x:Name="SizeList" Grid.Row="1" SelectionChanged="SizeList_SelectionChanged" />
        </Grid>

        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0">
            <CheckBox x:Name="BoldBox" Content="_Bold" Margin="0,0,18,0" Click="Selection_Changed" />
            <CheckBox x:Name="ItalicBox" Content="_Italic" Click="Selection_Changed" />
        </StackPanel>

        <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0"
                BorderBrush="#CCCCCC" BorderThickness="1" Height="64">
            <TextBlock x:Name="Preview" Text="AaBbYyZz 0123" VerticalAlignment="Center"
                       HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </Border>

        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Click="Ok_Click" IsDefault="True" Width="80" Margin="0,0,8,0" Padding="0,4" />
            <Button Content="Cancel" IsCancel="True" Width="80" Padding="0,4" />
        </StackPanel>
    </Grid>
</local:ThemedWindow>
