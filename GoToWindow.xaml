<local:ThemedWindow x:Class="Jester.GoToWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Jester"
        Style="{StaticResource JesterWindowStyle}"
        Title="Go To Line" SizeToContent="Height" Width="300"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="14">
        <TextBlock x:Name="PromptText" Text="Line number:" Margin="0,0,0,6" />
        <TextBox x:Name="LineBox" Padding="2,3" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Go To" Click="Ok_Click" IsDefault="True" Width="74" Margin="0,0,8,0" Padding="0,4" />
            <Button Content="Cancel" IsCancel="True" Width="74" Padding="0,4" />
        </StackPanel>
    </StackPanel>
</local:ThemedWindow>
