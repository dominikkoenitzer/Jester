<local:ThemedWindow x:Class="Jester.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Jester"
        Style="{StaticResource JesterWindowStyle}"
        Title="Untitled - Jester"
        Width="950" Height="640"
        MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing"
        UseLayoutRounding="True">

    <local:ThemedWindow.TitleBarContent>
        <Menu>
            <MenuItem Header="_File" SubmenuOpened="FileMenu_SubmenuOpened">
                <MenuItem Header="_New Tab" Command="ApplicationCommands.New" InputGestureText="Ctrl+N" />
                <MenuItem Header="_Open..." Command="ApplicationCommands.Open" InputGestureText="Ctrl+O" />
                <MenuItem x:Name="RecentFilesMenu" Header="Open _Recent" />
                <MenuItem x:Name="ReopenMenu" Header="Reopen with _Encoding">
                    <MenuItem Header="UTF-8" Click="ReopenWithEncoding_Click" Tag="utf-8" />
                    <MenuItem Header="UTF-8 with BOM" Click="ReopenWithEncoding_Click" Tag="utf-8-bom" />
                    <MenuItem Header="UTF-16 LE" Click="ReopenWithEncoding_Click" Tag="utf-16le" />
                    <MenuItem Header="UTF-16 BE" Click="ReopenWithEncoding_Click" Tag="utf-16be" />
                    <MenuItem Header="Windows-1252" Click="ReopenWithEncoding_Click" Tag="windows-1252" />
                    <MenuItem x:Name="AnsiReopenMenuItem" Header="ANSI" Click="ReopenWithEncoding_Click" Tag="ansi" />
                </MenuItem>
                <Separator />
                <MenuItem Header="_Save" Command="ApplicationCommands.Save" InputGestureText="Ctrl+S" />
                <MenuItem Header="Save _As..." Command="{x:Static local:JesterCommands.SaveAs}" />
                <MenuItem Header="Save A_ll" Command="{x:Static local:JesterCommands.SaveAll}" />
                <Separator />
                <MenuItem Header="Export to _PDF..." Command="{x:Static local:JesterCommands.ExportPdf}" />
                <Separator />
                <MenuItem Header="_Close Tab" Command="{x:Static local:JesterCommands.CloseTab}" />
                <MenuItem Header="E_xit" Command="{x:Static local:JesterCommands.Exit}" />
            </MenuItem>

            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" Command="ApplicationCommands.Undo" />
                <MenuItem Header="_Redo" Command="ApplicationCommands.Redo" />
                <Separator />
                <MenuItem Header="Cu_t" Command="ApplicationCommands.Cut" />
                <MenuItem Header="_Copy" Command="ApplicationCommands.Copy" />
                <MenuItem Header="_Paste" Command="ApplicationCommands.Paste" />
                <MenuItem Header="De_lete" Command="ApplicationCommands.Delete" />
                <Separator />
                <MenuItem Header="_Find..." Command="ApplicationCommands.Find" />
                <MenuItem Header="Find _Next" Command="{x:Static local:JesterCommands.FindNext}" />
                <MenuItem Header="Find _Previous" Command="{x:Static local:JesterCommands.FindPrevious}" />
                <MenuItem Header="_Replace..." Command="ApplicationCommands.Replace" />
                <MenuItem Header="Find in F_iles..." Command="{x:Static local:JesterCommands.FindInFiles}" />
                <MenuItem Header="_Go To..." Command="{x:Static local:JesterCommands.GoTo}" />
                <Separator />
                <MenuItem Header="Select _All" Command="ApplicationCommands.SelectAll" />
                <MenuItem Header="Time/_Date" Command="{x:Static local:JesterCommands.InsertDateTime}" />
            </MenuItem>

            <MenuItem Header="F_ormat">
                <MenuItem x:Name="WordWrapMenuItem" Header="_Word Wrap"
                          IsCheckable="True" Click="WordWrap_Click" />
                <MenuItem x:Name="AutoIndentMenuItem" Header="_Auto Indent"
                          IsCheckable="True" IsChecked="True" Click="AutoIndent_Click" />
                <MenuItem Header="_Font..." Command="{x:Static local:JesterCommands.ChooseFont}" />
                <Separator />
                <MenuItem Header="_Line Endings">
                    <MenuItem x:Name="CrlfMenuItem" Header="Windows (_CRLF)" IsCheckable="True" Click="LineEnding_Click" Tag="CRLF" />
                    <MenuItem x:Name="LfMenuItem" Header="Unix (_LF)" IsCheckable="True" Click="LineEnding_Click" Tag="LF" />
                    <MenuItem x:Name="CrMenuItem" Header="Macintosh (C_R)" IsCheckable="True" Click="LineEnding_Click" Tag="CR" />
                </MenuItem>
                <MenuItem Header="_Encoding">
                    <MenuItem x:Name="Utf8MenuItem" Header="UTF-8" IsCheckable="True" Click="Encoding_Click" Tag="utf-8" />
                    <MenuItem x:Name="Utf8BomMenuItem" Header="UTF-8 with BOM" IsCheckable="True" Click="Encoding_Click" Tag="utf-8-bom" />
                    <MenuItem x:Name="Utf16LeMenuItem" Header="UTF-16 LE" IsCheckable="True" Click="Encoding_Click" Tag="utf-16le" />
                    <MenuItem x:Name="Utf16BeMenuItem" Header="UTF-16 BE" IsCheckable="True" Click="Encoding_Click" Tag="utf-16be" />
                </MenuItem>
            </MenuItem>

            <MenuItem Header="_View">
                <MenuItem Header="_Zoom">
                    <MenuItem Header="Zoom _In" Command="{x:Static local:JesterCommands.ZoomIn}" />
                    <MenuItem Header="Zoom _Out" Command="{x:Static local:JesterCommands.ZoomOut}" />
                    <MenuItem Header="_Restore Default Zoom" Command="{x:Static local:JesterCommands.RestoreZoom}" />
                </MenuItem>
                <MenuItem x:Name="LineNumbersMenuItem" Header="Line _Numbers"
                          IsCheckable="True" IsChecked="True" Click="LineNumbers_Click" />
                <MenuItem x:Name="StatusBarMenuItem" Header="_Status Bar"
                          IsCheckable="True" IsChecked="True" Click="StatusBar_Click" />
            </MenuItem>
        </Menu>
    </local:ThemedWindow.TitleBarContent>

    <DockPanel>
        <Border x:Name="StatusBarControl" DockPanel.Dock="Bottom" Height="28"
                Background="{DynamicResource WindowBackgroundBrush}"
                BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <Grid.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource StatusTextBrush}" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                </Grid.Resources>
                <TextBlock x:Name="DocInfo" HorizontalAlignment="Left" Text="0 chars · 1 lines" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="PositionInfo" Text="Ln 1, Col 1" Margin="0,0,24,0" />
                    <TextBlock x:Name="ZoomInfo" Text="100%" Margin="0,0,24,0" />
                    <TextBlock x:Name="LineEndingInfo" Text="Windows (CRLF)" Margin="0,0,24,0" />
                    <TextBlock x:Name="EncodingInfo" Text="UTF-8" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Find in Files results, shown above the status bar on demand -->
        <Border x:Name="FindResultsPanel" DockPanel.Dock="Bottom" Visibility="Collapsed" Height="200"
                Background="{DynamicResource WindowBackgroundBrush}"
                BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Height="34">
                    <TextBlock x:Name="FindResultsHeader" Margin="16,0,48,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource ChromeTextBrush}" FontSize="12" Text="Find results"
                               TextTrimming="CharacterEllipsis" />
                    <Button HorizontalAlignment="Right" Margin="0,0,10,0" Width="26" Height="24"
                            Style="{StaticResource TabCloseButton}" FontSize="9" Content="&#xE8BB;"
                            Foreground="{DynamicResource ChromeTextBrush}" ToolTip="Close"
                            Click="CloseFindResults_Click" />
                </Grid>
                <ListBox x:Name="FindResultsList" BorderThickness="0" Background="Transparent" Padding="8,0,8,6"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         MouseDoubleClick="FindResults_DoubleClick" KeyDown="FindResults_KeyDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Location}" FontFamily="{DynamicResource MonoFont}" FontSize="12"
                                           Foreground="{DynamicResource ResultLocationBrush}" Width="240" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Preview}" FontFamily="{DynamicResource MonoFont}" FontSize="12"
                                           Foreground="{DynamicResource EditorForegroundBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid>
            <TabControl x:Name="Tabs" Style="{StaticResource JesterTabControl}"
                        ItemContainerStyle="{StaticResource JesterTabItem}"
                        SelectionChanged="Tabs_SelectionChanged"
                        PreviewMouseDown="Tabs_PreviewMouseDown">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Header}" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                            <Grid Margin="10,0,0,0" Width="20" Height="20">
                                <Ellipse x:Name="DirtyMark" Width="7" Height="7" Visibility="Collapsed"
                                         Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                                <Button x:Name="CloseButton" Content="&#xE8BB;" FontSize="9" Visibility="Hidden"
                                        Style="{StaticResource TabCloseButton}"
                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"
                                        Click="CloseTabButton_Click" ToolTip="Close tab" />
                            </Grid>
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TabItem}}" Value="True">
                                <Setter TargetName="CloseButton" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=TabItem}}" Value="True">
                                <Setter TargetName="CloseButton" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <!-- Unsaved: a dot in the close button's place until the pointer is on the tab. -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsDirty}" Value="True" />
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=TabItem}}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="DirtyMark" Property="Visibility" Value="Visible" />
                                <Setter TargetName="CloseButton" Property="Visibility" Value="Hidden" />
                            </MultiDataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <ContentPresenter Content="{Binding View}" />
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>

            <local:FindPanel x:Name="FindBar" HorizontalAlignment="Right" VerticalAlignment="Top"
                             Margin="0,46,24,0" Visibility="Collapsed" />
        </Grid>
    </DockPanel>
</local:ThemedWindow>
