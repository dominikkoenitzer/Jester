<?xml version="1.0" encoding="utf-8"?>
<!-- TOML. Each colour is named after a SyntaxKind; the palette gives it its colour. -->
<SyntaxDefinition name="TOML" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Comment" fontStyle="italic" />
  <Color name="String" />
  <Color name="Escape" />
  <Color name="Number" />
  <Color name="Constant" />
  <Color name="Property" />
  <Color name="Heading" fontWeight="bold" />

  <RuleSet name="Escapes">
    <Span color="Escape" begin="\\" end="u[0-9a-fA-F]{4}|U[0-9a-fA-F]{8}|.|$" />
  </RuleSet>

  <RuleSet name="Strings">
    <Span color="String" multiline="true" begin="&quot;&quot;&quot;" end="&quot;&quot;&quot;(?!&quot;)" ruleSet="Escapes" />
    <Span color="String" multiline="true" begin="'''" end="'''(?!')" />
    <Span color="String" begin="&quot;" end="&quot;" ruleSet="Escapes" />
    <Span color="String" begin="'" end="'" />
  </RuleSet>

  <!-- A value: strings, dates, numbers, and arrays and inline tables of them. -->
  <RuleSet name="Value">
    <Span color="Comment" begin="\#" />
    <Import ruleSet="Strings" />
    <Span begin="\[" end="\]" multiline="true" ruleSet="Value" />
    <Span begin="\{" end="\}" ruleSet="Table" />
    <Keywords color="Constant">
      <Word>true</Word>
      <Word>false</Word>
      <Word>inf</Word>
      <Word>nan</Word>
    </Keywords>
    <Rule color="Number">[0-9]{4}-[0-9]{2}-[0-9]{2}(?:[Tt ][0-9]{2}:[0-9]{2}(?::[0-9]{2}(?:\.[0-9]+)?)?(?:[Zz]|[-+][0-9]{2}:[0-9]{2})?)?|[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\.[0-9]+)?|[-+]?(?:0x[0-9a-fA-F_]+|0o[0-7_]+|0b[01_]+|(?:inf|nan)\b|[0-9][0-9_]*(?:\.[0-9_]+)?(?:[eE][-+]?[0-9_]+)?)</Rule>
  </RuleSet>

  <!-- Inside an inline table: keys and their values. -->
  <RuleSet name="Table">
    <Span ruleSet="Value" end="(?=[,}])">
      <Begin>=</Begin>
    </Span>
    <Span color="Property" begin="&quot;" end="&quot;" ruleSet="Escapes" />
    <Span color="Property" begin="'" end="'" />
    <Rule color="Property">[A-Za-z0-9_-]+</Rule>
  </RuleSet>

  <RuleSet>
    <Span color="Comment" begin="\#" />

    <!-- A table header runs to the end of its line, a comment after it aside. -->
    <Span color="Heading" begin="^\s*\[" end="\](?=\s*(?:\#|$))|$">
      <RuleSet>
        <Span color="Heading" begin="&quot;" end="&quot;" ruleSet="Escapes" />
      </RuleSet>
    </Span>

    <!-- After the equals sign comes the value, up to the end of the line, or further for a
         multi-line string or array. -->
    <Span ruleSet="Value" end="$">
      <Begin>=</Begin>
    </Span>

    <Span color="Property" begin="&quot;" end="&quot;" ruleSet="Escapes" />
    <Span color="Property" begin="'" end="'" />
    <Rule color="Property">[A-Za-z0-9_-]+</Rule>
  </RuleSet>
</SyntaxDefinition>
